{
  "name": "budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "jose": "^6.1.3",
    "plaid": "^31.0.0"
  },
  "scripts": {
    "start": "bun run build && bun run start-server",
    "start-server": "bun ./build/server/bundle.js",
    "build": "bun run build-server && bun run build-client",
    "build-client": "vite build",
    "build-server": "bun ./src/server/pack.ts",
    "dev": "bun run dev-client & bun run dev-server",
    "dev-client": "vite",
    "dev-server": "bun --watch ./src/server/start.ts",
    "test": "bun test --preload ./scripts/test-preload.ts src",
    "test:coverage": "bun test --preload ./scripts/test-preload.ts --coverage --coverage-reporter=lcov src && bun scripts/check-coverage.ts",
    "lint": "bun --bun eslint src",
    "lint:fix": "bun --bun eslint src --fix",
    "typecheck": "bun run --bun tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.1.0",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "happy-dom": "^20.14.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-plaid-link": "^3.3.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
