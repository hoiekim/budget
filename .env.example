HOST_NAME=example.com

# Opt in to the production posture: secure cookies and HSTS.
#
# Consumed at BUILD time, not at runtime. src/server/pack.ts bundles with
# Bun.build({ target: "bun" }), which folds this into a constant, so the value
# present when the bundle is built is the value that ships. Whether that moment
# is still yours is what separates the two setups.
#
# From a source checkout it is: `bun run start` builds before it serves, and
# Bun loads .env.local into that build, so uncommenting the line below is the
# whole opt-in.
#
# For a prebuilt image it is not. The Dockerfile here never sets NODE_ENV, so
# an image built from this repo — the published one included — ships the
# non-production posture: the session cookie carries no Secure attribute and no
# HSTS header is sent. No runtime environment can change that; opting in means
# rebuilding the image with NODE_ENV set. See docs/GETTING_STARTED.md.
# NODE_ENV=production

# Optional: HTTP listen port. Default: 3005. See src/server/start.ts.
# PORT=3005

# Optional: Discord webhook URL for server error alarms (unhandled exceptions, 5xx errors, client JS errors)
# DISCORD_ALARM_WEBHOOK=https://discord.com/api/webhooks/...

ADMIN_PASSWORD=qwert12345

# Password for the `demo` account, which is created on every startup
# alongside `admin` (src/server/lib/postgres/initialize.ts). Unset means the
# literal `budget` — the value published for the public demo instance — so a
# private deployment should set it. The account is pinned to Plaid's sandbox
# environment (src/server/lib/plaid/util.ts); the SimpleFin path has no such
# gate, so treat the account as a real user of every other integration.
# DEMO_PASSWORD=

# Optional: log verbosity. One of debug | info | warn | error.
# Default: info (or error when NODE_ENV=test). See src/server/lib/logger.ts.
# LOG_LEVEL=info

PLAID_CLIENT_ID=000000000
PLAID_SECRET_PRODUCTION=000000000
PLAID_SECRET_DEVELOPMENT=000000000
PLAID_SECRET_SANDBOX=000000000

POLYGON_API_KEY=000000000

# Optional: cap outbound Polygon requests per minute. Free tier is 5/min;
# set to 0 to disable the rate-limit gate (paid tiers / tests).
# Default: 5. See src/server/lib/polygon.ts.
# POLYGON_RATE_LIMIT_PER_MIN=5

# Optional: Bureau of Labor Statistics API registration key, used by the hourly
# job that stores CPI history for the projection chart's auto inflation rate.
# Without it the keyless v1 API is used (25 requests/day, 10 years each); with
# it, v2 (500/day, 20 years each). The job spends at most 10 or 50 requests a
# day respectively. Register at https://data.bls.gov/registrationEngine/.
# See src/server/lib/bls.ts.
# BLS_API_KEY=

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=budget
